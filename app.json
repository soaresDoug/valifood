{
  "expo": {
    "name": "ValiFood",
    "slug": "valifood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#085D38",
    "scheme": "valifood",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.valifood.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O ValiFood usa a câmera para ler o código de barras dos produtos e para tirar a foto do alimento.",
        "NSPhotoLibraryUsageDescription": "O ValiFood acessa suas fotos para você escolher a imagem do produto."
      }
    },
    "android": {
      "package": "app.valifood.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#085D38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "O ValiFood usa a câmera para ler o código de barras dos produtos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4CAF50",
          "defaultChannel": "valifood-expiry",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O ValiFood acessa suas fotos para você escolher a imagem do produto.",
          "cameraPermission": "O ValiFood usa a câmera para fotografar o produto."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF8",
          "dark": {
            "backgroundColor": "#F7FAF8"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aaea93a3-59af-43b0-a298-d666f29f0ca1"
      }
    },
    "owner": "soaresd"
  }
}
